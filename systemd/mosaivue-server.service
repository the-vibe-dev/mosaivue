[Unit]
Description=Mosaivue API and web administration service
Documentation=file:/opt/mosaivue/current/docs/install.md
After=network-online.target mosaivue-renderer.service
Wants=network-online.target

[Service]
Type=simple
User=mosaivue
Group=mosaivue
Environment=PYTHONUNBUFFERED=1
Environment=MOSAIVUE_CONFIG=/etc/mosaivue/config.json
Environment=MOSAIVUE_DATA_DIR=/var/lib/mosaivue
Environment=MOSAIVUE_CONFIG_DIR=/etc/mosaivue
Environment=MOSAIVUE_CACHE_DIR=/var/cache/mosaivue
Environment=MOSAIVUE_LOG_DIR=/var/log/mosaivue
Environment=MOSAIVUE_RUN_DIR=/run/mosaivue
ExecStart=/opt/mosaivue/current/.venv/bin/mosaivue-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/mosaivue /var/cache/mosaivue /var/log/mosaivue /run/mosaivue /etc/mosaivue

[Install]
WantedBy=multi-user.target
